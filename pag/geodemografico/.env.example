# Plantilla de configuración. Solo nombres: nunca escribir valores reales aquí.
# Copiar a .env (ignorado por git) y completar en el entorno local.

# --- Entorno ---
NODE_ENV=
APP_ENV=
PORT=
PUBLIC_WEB_ORIGIN=
# Ruta bajo la que se sirve la app. En produccion: /geodemografico
BASE_PATH=

# --- Base de datos ---
# En local, `pnpm db:start` levanta PGlite y expone esta URL.
DATABASE_URL=
# Rol de runtime: SIN superusuario, SIN BYPASSRLS, SIN propiedad de tablas.
DATABASE_RUNTIME_ROLE=
# Rol exclusivo de migraciones. Distinto del de runtime.
DATABASE_MIGRATION_URL=

# --- Sesiones ---
# 32 bytes aleatorios en base64. Generar con: node scripts/gen-secret.mjs
SESSION_SECRET=
SESSION_TTL_HOURS=

# --- Identidad (Google OIDC) ---
# Depende de un proyecto Google Cloud. Ver docs/runbooks/configuracion-externa.md
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Obligatorio en produccion: kaizensolutionscol.com. Solo entran cuentas del
# Workspace de Kaizen con membresia o registro autorizado.
OIDC_ALLOWED_HD=

# --- OAuth de Drive: identidades separadas lector e ingestor ---
GOOGLE_READER_CLIENT_ID=
GOOGLE_READER_CLIENT_SECRET=
GOOGLE_READER_REDIRECT_URI=
GOOGLE_INGESTOR_CLIENT_ID=
GOOGLE_INGESTOR_CLIENT_SECRET=
GOOGLE_INGESTOR_REDIRECT_URI=

# --- Cifrado del vault de tokens OAuth ---
TOKEN_VAULT_KEY=

# --- Proveedor de modelo ---
# gemini_developer | fake. `fake` es el adaptador determinista local.
LLM_PROVIDER=
GEMINI_MODEL=
GEMINI_THINKING_LEVEL=
# NUNCA versionar ni imprimir. Se inyecta por gestor de secretos del proceso.
GEMINI_API_KEY=
# Ruta a archivo local con la credencial, solo para bootstrap de desarrollo.
GEMINI_API_KEY_FILE=

# --- Embeddings ---
EMBEDDINGS_PROVIDER=
EMBEDDINGS_MODEL=
EMBEDDINGS_DIMENSION=

# --- Conector de fuentes documentales ---
# google_drive | fixture. `fixture` usa evals/fixtures sin tocar la red.
SOURCE_PROVIDER=

# --- Admisión y límites ---
REDIS_URL=
RATE_LIMIT_ENABLED=
