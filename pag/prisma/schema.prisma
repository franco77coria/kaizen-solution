// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  directUrl    = env("DIRECT_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("VIEWER") // SUPER_ADMIN, ADMIN, VIEWER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id              String   @id @default(cuid())
  companyName     String   @default("KAIZEN SOLUTION S.A.S.")
  email           String
  phone           String?
  whatsappNumber  String?
  whatsappMessage String?
  address         String?
  city            String   @default("Bogotá")
  country         String   @default("Colombia")
  linkedinUrl     String?
  instagramUrl    String?
  facebookUrl     String?
  twitterUrl      String?
  heroTitle       String   @default("Transformación Digital con Propósito")
  heroSubtitle    String   @default("Soluciones digitales a medida para tu negocio y la gestión pública")
  ctaText         String   @default("Agenda tu Diagnóstico de Madurez Digital")
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  category    String   @default("general")
  features    String   @default("[]") // JSON array of feature strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  imageUrl    String?
  tags        String   @default("[]") // JSON array of tags
  clientName  String?
  results     String? // Metrics or results achieved
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  company    String?
  position   String?
  content    String
  rating     Int      @default(5)
  imageUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  source    String   @default("website")
  status    String   @default("new") // new, contacted, qualified, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatLead {
  id                  String   @id @default(cuid())
  name                String
  email               String? // Del formulario de contacto; el chatbot no lo pide
  whatsapp            String
  company             String?
  conversationSummary String   @db.Text // Summary of what the user was interested in
  status              String   @default("new") // new, contacted, qualified, closed
  notes               String?  @db.Text // Admin notes
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════
//  Tablero de Políticas Públicas Municipales — /politica/[municipio]
//
//  Migrado desde el Google Sheet de la Alcaldía de Anapoima. El prefijo Pol
//  evita colisiones con los modelos del sitio y del CRM de WhatsApp.
//
//  Este schema usa relationMode = "prisma", así que no hay foreign keys reales
//  en Postgres: cada campo de relación lleva su @@index a mano.
// ═══════════════════════════════════════════════════════════════════════════

enum PolTipoMeta {
  BOOLEANO
  NUMERO
  SIN_DEFINIR
}

enum PolPeriodicidad {
  ANUAL
  CUATRIENIO
  DECENIO
  SIN_DEFINIR
}

enum PolRol {
  SUPERADMIN
  ADMIN
  REPORTA
  CONSULTA
}

enum PolTipoPermiso {
  TODO
  POLITICA
  DEPENDENCIA
}

enum PolOrigenEvidencia {
  DRIVE
  STORAGE
}

model PolMunicipio {
  id            String   @id @default(cuid())
  slug          String   @unique
  nombre        String
  departamento  String?
  lema          String?
  periodoInicio Int
  periodoFin    Int
  activo        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  politicas    PolPolitica[]
  dependencias PolDependencia[]
  indicadores  PolIndicador[]
  actividades  PolActividad[]
  usuarios     PolUsuario[]
  avances      PolAvance[]
  auditoria    PolAuditoria[]
}

model PolPolitica {
  id          String @id @default(cuid())
  municipioId String
  nombre      String
  anioInicio  Int?
  anioFin     Int?
  orden       Int    @default(0)

  municipio   PolMunicipio           @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  ejes        PolEje[]
  indicadores PolIndicador[]
  actividades PolActividadPolitica[]
  permisos    PolPermiso[]

  @@unique([municipioId, nombre])
  @@index([municipioId])
}

model PolEje {
  id         String  @id @default(cuid())
  politicaId String
  codigo     String?
  nombre     String
  orden      Int     @default(0)

  politica PolPolitica @relation(fields: [politicaId], references: [id], onDelete: Cascade)
  lineas   PolLinea[]

  @@unique([politicaId, nombre])
  @@index([politicaId])
}

model PolLinea {
  id               String  @id @default(cuid())
  ejeId            String
  nombre           String
  lineaEstrategica String?

  eje         PolEje         @relation(fields: [ejeId], references: [id], onDelete: Cascade)
  actividades PolActividad[]

  @@unique([ejeId, nombre])
  @@index([ejeId])
}

model PolDependencia {
  id          String @id @default(cuid())
  municipioId String
  nombre      String

  municipio   PolMunicipio   @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  actividades PolActividad[]
  usuarios    PolUsuario[]
  permisos    PolPermiso[]

  @@unique([municipioId, nombre])
  @@index([municipioId])
}

model PolIndicador {
  id           String  @id @default(cuid())
  municipioId  String
  politicaId   String?
  codigo       String // ID_INDICADOR, ej. "MEG1"
  nombre       String  @db.Text
  nombreOrigen String? @db.Text // "INDICADOR DEL EJE" del sheet
  fuente       String? @db.Text
  unidadMedida String?
  formula      String? @db.Text
  menorEsMejor Boolean @default(false)
  comentarios  String? @db.Text

  municipio   PolMunicipio       @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  politica    PolPolitica?       @relation(fields: [politicaId], references: [id])
  metas       PolIndicadorMeta[]
  actividades PolActividad[]

  @@unique([municipioId, codigo])
  @@index([municipioId])
  @@index([politicaId])
}

// Los años vivían en los encabezados del sheet (META_NUMERICA_2024, REAL_2024...)
// y se extraían con una regex sobre los nombres de columna. Normalizados como
// filas, sumar 2027 es insertar datos y no tocar código.
model PolIndicadorMeta {
  id          String   @id @default(cuid())
  indicadorId String
  anio        Int
  meta        Decimal? @db.Decimal(16, 4)
  real        Decimal? @db.Decimal(16, 4)

  indicador PolIndicador @relation(fields: [indicadorId], references: [id], onDelete: Cascade)

  @@unique([indicadorId, anio])
  @@index([indicadorId])
}

model PolActividad {
  id            String  @id @default(cuid())
  municipioId   String
  lineaId       String?
  dependenciaId String?
  indicadorId   String?

  codigo       String? // CODIGO_ACTIVIDAD: no es único, reinicia en cada política
  nombre       String  @db.Text
  subactividad String? @db.Text

  tipoMeta     PolTipoMeta @default(SIN_DEFINIR)
  metaNumero   Decimal?    @db.Decimal(16, 4)
  metaBooleana Boolean?

  periodicidad    PolPeriodicidad @default(SIN_DEFINIR)
  periodicidadRaw String? // texto original: el sheet dice "Cuatrenio", sin la i

  presupuestoPlaneado  Decimal? @db.Decimal(16, 2)
  presupuestoPendiente Boolean  @default(false) // 146 filas dicen "PENDIENTE"

  // Nombre normalizado + metadata de la meta. Deduplica en la importación y la
  // hace repetible: dos filas con el mismo nombre pero distinta meta no se funden.
  claveDedupe String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  municipio   PolMunicipio           @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  linea       PolLinea?              @relation(fields: [lineaId], references: [id])
  dependencia PolDependencia?        @relation(fields: [dependenciaId], references: [id])
  indicador   PolIndicador?          @relation(fields: [indicadorId], references: [id])
  politicas   PolActividadPolitica[]
  avances     PolAvance[]

  @@unique([municipioId, claveDedupe])
  @@index([municipioId])
  @@index([lineaId])
  @@index([dependenciaId])
  @@index([indicadorId])
}

// Una misma actividad real puede servir a varias políticas. Antes eso eran filas
// duplicadas y el avance se replicaba entre ellas porque coincidían los nombres.
model PolActividadPolitica {
  actividadId String
  politicaId  String

  actividad PolActividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  politica  PolPolitica  @relation(fields: [politicaId], references: [id], onDelete: Cascade)

  @@id([actividadId, politicaId])
  @@index([actividadId])
  @@index([politicaId])
}

model PolAvance {
  id          String  @id @default(cuid())
  municipioId String
  actividadId String?
  usuarioId   String?

  // Período: en el sheet conviven años sueltos ("2025") y rangos de fechas.
  anio         Int?
  fechaDesde   DateTime?
  fechaHasta   DateTime?
  periodoTexto String?

  valorNumero   Decimal? @db.Decimal(16, 4)
  valorBooleano Boolean?
  valorRaw      String? // lo que vino tal cual: "3", "Realizado", ...

  observaciones        String?  @db.Text
  presupuestoEjecutado Decimal? @db.Decimal(16, 2)

  // false = no cruzó con ninguna actividad. Antes se descartaban en silencio.
  conciliado     Boolean @default(true)
  actividadTexto String? @db.Text // nombre original, para reconciliarlo después

  origenFila Int? // fila del sheet, para que reimportar no duplique
  createdAt  DateTime @default(now())

  municipio  PolMunicipio   @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  actividad  PolActividad?  @relation(fields: [actividadId], references: [id])
  usuario    PolUsuario?    @relation(fields: [usuarioId], references: [id])
  evidencias PolEvidencia[]

  @@unique([municipioId, origenFila])
  @@index([municipioId])
  @@index([actividadId])
  @@index([usuarioId])
  @@index([anio])
}

model PolEvidencia {
  id       String             @id @default(cuid())
  avanceId String
  url      String             @db.Text
  nombre   String?
  mime     String?
  tamano   Int?
  origen   PolOrigenEvidencia @default(STORAGE)

  avance PolAvance @relation(fields: [avanceId], references: [id], onDelete: Cascade)

  @@index([avanceId])
}

model PolUsuario {
  id            String  @id @default(cuid())
  municipioId   String
  dependenciaId String?

  nombre      String
  telefono    String? // sólo dígitos
  telefonoRaw String? // como venía en el sheet
  correo      String?

  rol    PolRol  @default(REPORTA)
  activo Boolean @default(true)

  // Reservado: hoy el login es sólo por nombre o teléfono, sin clave.
  passwordHash String?

  ultimoIngreso DateTime?
  claveDedupe   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  municipio   PolMunicipio    @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  dependencia PolDependencia? @relation(fields: [dependenciaId], references: [id])
  permiso     PolPermiso?
  avances     PolAvance[]
  auditoria   PolAuditoria[]

  @@unique([municipioId, claveDedupe])
  @@index([municipioId])
  @@index([dependenciaId])
  @@index([telefono])
}

model PolPermiso {
  id            String         @id @default(cuid())
  usuarioId     String         @unique
  tipo          PolTipoPermiso @default(TODO)
  politicaId    String?
  dependenciaId String?
  valorRaw      String? // el texto que traía control_permisos
  updatedAt     DateTime       @updatedAt

  usuario     PolUsuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  politica    PolPolitica?    @relation(fields: [politicaId], references: [id])
  dependencia PolDependencia? @relation(fields: [dependenciaId], references: [id])

  @@index([politicaId])
  @@index([dependenciaId])
}

model PolAuditoria {
  id          String  @id @default(cuid())
  municipioId String
  usuarioId   String?

  accion      String // "Login" | "Modificacion" | "Permiso"
  detalle     String? @db.Text
  usuarioText String? // nombre tal como quedó registrado
  ip          String?
  userAgent   String? @db.Text

  origenFila Int?
  createdAt  DateTime @default(now())

  municipio PolMunicipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  usuario   PolUsuario?  @relation(fields: [usuarioId], references: [id])

  @@unique([municipioId, origenFila])
  @@index([municipioId])
  @@index([usuarioId])
  @@index([createdAt])
}
