// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("VIEWER") // SUPER_ADMIN, ADMIN, VIEWER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id              String   @id @default(cuid())
  companyName     String   @default("KAIZEN SOLUTION S.A.S.")
  email           String
  phone           String?
  whatsappNumber  String?
  whatsappMessage String?
  address         String?
  city            String   @default("Bogotá")
  country         String   @default("Colombia")
  linkedinUrl     String?
  instagramUrl    String?
  facebookUrl     String?
  twitterUrl      String?
  heroTitle       String   @default("Transformación Digital con Propósito")
  heroSubtitle    String   @default("Soluciones digitales a medida para tu negocio y la gestión pública")
  ctaText         String   @default("Agenda tu Diagnóstico de Madurez Digital")
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  category    String   @default("general")
  features    String   @default("[]") // JSON array of feature strings
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  imageUrl    String?
  tags        String   @default("[]") // JSON array of tags
  clientName  String?
  results     String? // Metrics or results achieved
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id         String   @id @default(cuid())
  clientName String
  company    String?
  position   String?
  content    String
  rating     Int      @default(5)
  imageUrl   String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String
  source    String   @default("website")
  status    String   @default("new") // new, contacted, qualified, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatLead {
  id                  String   @id @default(cuid())
  name                String
  whatsapp            String
  conversationSummary String   @db.Text // Summary of what the user was interested in
  status              String   @default("new") // new, contacted, qualified, closed
  notes               String?  @db.Text // Admin notes
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ─── WhatsApp Integration ───

model WhatsAppConfig {
  id            String   @id @default(cuid())
  apiToken      String   @db.Text
  phoneNumberId String
  wabaId        String?
  verifyToken   String   @default("kaizen_whatsapp_2026")
  apiVersion    String   @default("v21.0")
  isConfigured  Boolean  @default(false)
  updatedAt     DateTime @updatedAt
}

model WhatsAppMessage {
  id          String   @id @default(cuid())
  messageId   String?  @unique
  direction   String // "inbound" | "outbound"
  phone       String
  contactName String?
  content     String   @db.Text
  type        String   @default("text")
  status      String   @default("sent")
  isRead      Boolean  @default(false)
  timestamp   DateTime @default(now())

  @@index([phone])
  @@index([direction])
  @@index([timestamp])
}

model WhatsAppContact {
  id            String    @id @default(cuid())
  phone         String    @unique
  name          String?
  source        String?   // "CSV", "WEBHOOK", "MANUAL"
  externalId    String?   // Para cruzar con otras bases de datos del cliente
  tags          String    @default("[]") // JSON array
  optInStatus   Boolean   @default(true) // Si false, está en la lista de supresión
  lastMessageAt DateTime?
  totalMessages Int       @default(0)
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones
  listSubscriptions ListSubscriber[]
}

model ContactList {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  subscribers ListSubscriber[]
  campaigns   WhatsAppCampaign[]
}

model ListSubscriber {
  id        String   @id @default(cuid())
  listId    String
  contactId String
  createdAt DateTime @default(now())

  // Relaciones
  list      ContactList     @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([listId, contactId])
  @@index([listId])
  @@index([contactId])
}

model WhatsAppTemplate {
  id          String   @id @default(cuid())
  wabaId      String   // ID del template en Meta
  name        String
  language    String
  status      String   // APPROVED, PENDING, REJECTED
  category    String?
  bodyText    String   @db.Text
  components  String   @db.Text // JSON con toda la estructura (header, body, buttons)
  variables   String   @default("[]") // JSON array de los nombres de variables mapeables
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  campaigns WhatsAppCampaign[]

  @@unique([name, language])
}

model WhatsAppCampaign {
  id           String    @id @default(cuid())
  name         String
  type         String    @default("template") // "template" | "audio"
  listId       String
  templateId   String?
  status       String    @default("draft") // draft, scheduled, running, paused, completed, failed
  scheduledFor DateTime?
  stats        String    @default("{}") // JSON: { total: 0, sent: 0, delivered: 0, read: 0, failed: 0 }
  mapping      String    @default("{}") // JSON: mapeo de variables ej. { "1": "name", "2": "custom_field" }
  audioConfig  String?   @db.Text // JSON: metadata para campañas tipo "audio"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relaciones
  list         ContactList        @relation(fields: [listId], references: [id])
  template     WhatsAppTemplate?  @relation(fields: [templateId], references: [id])
  jobs         CampaignJob[]

  @@index([listId])
  @@index([templateId])
}

model CampaignJob {
  id           String   @id @default(cuid())
  campaignId   String
  phone        String
  messageId    String?  @unique // Se llena cuando Meta nos da el ID
  status       String   @default("pending") // pending, sent, delivered, read, failed
  errorMessage String?  @db.Text
  processedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  campaign     WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([phone])
  @@index([status])
}

model WhatsAppLog {
  id        String   @id @default(cuid())
  type      String
  payload   String   @db.Text
  createdAt DateTime @default(now())
}

// ─── ElevenLabs Integration ───

model ElevenLabsConfig {
  id           String   @id @default(cuid())
  apiKey       String   @db.Text // encrypted
  voiceId      String   @default("21m00Tcm4TlvDq8ikWAM") // Rachel
  modelId      String   @default("eleven_multilingual_v2")
  isConfigured Boolean  @default(false)
  updatedAt    DateTime @updatedAt
}

model AudioMessageCache {
  id        String   @id @default(cuid())
  hash      String   @unique // Hash sha256 de (texto + voiceId)
  mediaUrl  String   @db.Text // URL pública donde está guardado temporalmente
  mediaId   String?  // ID que devuelve WhatsApp al subirlo (opcional, dura 30 días)
  createdAt DateTime @default(now())
  expiresAt DateTime? // Si usamos un storage que expira
}

// ─── API Usage Tracking ───

model ApiUsageLog {
  id        String   @id @default(cuid())
  service   String   // "whatsapp" | "elevenlabs"
  operation String   // "send_template", "send_text", "send_audio", "tts_generate", "bulk_template"
  cost      Float    @default(0)
  units     Int      @default(0) // chars for ElevenLabs, messages for WA
  metadata  String?  @db.Text    // JSON
  createdAt DateTime @default(now())

  @@index([service])
  @@index([createdAt])
}
