const provinceGroup=document.getElementById('province-group');
const provinciaInput=document.getElementById('provincia');
let isSubmitting=false;

// ==================== INICIALIZACIÓN ====================

const fechaNacimiento=document.getElementById('fecha_nacimiento');
const hoy=new Date().toISOString().split('T')[0];
fechaNacimiento.setAttribute('max', hoy);

function poblarDepartamentos() {
    const departamentos=Object.keys(colombiaData).sort();

    departamentos.forEach(dept=> {
            const option=document.createElement('option');
            option.value=dept;
            option.textContent=dept;
            departamentoSelect.appendChild(option);
        });
}

function poblarMunicipios(departamento) {
    municipioSelect.innerHTML='<option value="">Seleccione un municipio...</option>';

    if (departamento && colombiaData[departamento]) {
        const municipios=colombiaData[departamento].sort();

        municipios.forEach(mun=> {
                const option=document.createElement('option');
                option.value=mun;
                option.textContent=mun;
                municipioSelect.appendChild(option);
            });
        municipioSelect.disabled=false;
    }

    else {
        municipioSelect.disabled=true;
        municipioSelect.innerHTML='<option value="">Primero seleccione un departamento...</option>';
    }
}

// ==================== EVENT LISTENERS ====================

checkbox.addEventListener('change', function () {
        if (this.checked) {
            fieldset.disabled=false;
            submitButton.disabled=false;
        }

        else {
            fieldset.disabled=true;
            submitButton.disabled=true;
        }
    });

departamentoSelect.addEventListener('change', function () {
        const departamento=this.value;
        poblarMunicipios(departamento);
        municipioSelect.value='';
        provinceGroup.style.display='none';
        provinciaInput.value='';
    });

// Normalizar mapa de provincias para búsqueda insensible a mayúsculas/minúsculas
const cundinamarcaProvincesNormalized= {}

;

Object.keys(cundinamarcaProvinces).forEach(key=> {
        cundinamarcaProvincesNormalized[key.toLowerCase()]=cundinamarcaProvinces[key];
    });

municipioSelect.addEventListener('change', function () {
        const municipio=this.value;
        const departamento=departamentoSelect.value;

        // Búsqueda insensible a mayúsculas/minúsculas
        const provincia=(departamento==='Cundinamarca' && municipio) ? cundinamarcaProvincesNormalized[municipio.toLowerCase()] : null;

        if (provincia) {
            provinciaInput.value=provincia;
            provinceGroup.style.display='block';
            provinceGroup.style.opacity='0';
            setTimeout(()=> provinceGroup.style.opacity='1', 10);
            provinceGroup.style.transition='opacity 0.3s ease';
        }

        else {
            provinceGroup.style.display='none';
            provinciaInput.value='';
        }
    });

document.getElementById("referidosForm").addEventListener("submit", function (event) {
        event.preventDefault();

        if (isSubmitting) {
            return;
        }

        isSubmitting=true;
        const form=event.target;
        const data=Object.fromEntries(new FormData(form).entries());
        submitButton.disabled=true;
        document.getElementById('status').textContent='Enviando...';

        google.script.run .withSuccessHandler(function (response) {
                document.getElementById('status').textContent=response;
                form.reset();
                checkbox.checked=false;
                fieldset.disabled=true;
                submitButton.disabled=true;
                municipioSelect.disabled=true;
                isSubmitting=false;

            }) .withFailureHandler(function (error) {
                document.getElementById('status').textContent="Error: " + error.message;
                submitButton.disabled=false;
                isSubmitting=false;
            }) .guardarDatos(data);
    });

