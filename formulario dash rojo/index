// ==================== AUTOCOMPLETE DE LÍDERES ====================
var lideresData=[];
var activeIndex=-1;
var nombreLiderInput=document.getElementById('nombre_lider');
var ccLiderInput=document.getElementById('cc_lider');
var autocompleteList=document.getElementById('autocomplete-list');

function cargarLideres() {
    google.script.run .withSuccessHandler(function (data) {
            lideresData=data || [];
            console.log('Líderes cargados: ' + lideresData.length);

        }) .withFailureHandler(function (error) {
            console.error('Error cargando líderes:', error);
        }) .getLideres();
}

function renderSugerencias(filtro) {
    var query=filtro.toLowerCase().trim();

    if (query.length < 2) {
        autocompleteList.classList.remove('show');
        return;
    }

    var resultados=lideresData.filter(function (l) {
            return l.nombre.toLowerCase().indexOf(query) >=0;
        }).slice(0, 15);

    if (resultados.length===0) {
        autocompleteList.innerHTML='<div class="autocomplete-empty">No se encontraron líderes</div>';
        autocompleteList.classList.add('show');
        activeIndex=-1;
        return;
    }

    var html='';

    for (var i=0; i < resultados.length; i++) {
        var lider=resultados[i];
        var nombre=lider.nombre;
        var idx=nombre.toLowerCase().indexOf(query);
        var highlighted=nombre;

        if (idx >=0) {
            highlighted=nombre.substring(0, idx)+'<mark>'+nombre.substring(idx, idx + query.length)+'</mark>'+nombre.substring(idx + query.length);
        }

        var words=nombre.split(' ');
        var initials=(words[0] ? words[0][0] : '')+(words[1] ? words[1][0] : '');
        var ccDisplay=lider.cc ? 'CC: '+lider.cc : 'Sin CC';

        html+='<div class="autocomplete-item" data-index="'+i+'" data-nombre="'+nombre+'" data-cc="'+(lider.cc || '')+'">'+'<div class="item-icon">'+initials.toUpperCase()+'</div>'+'<div class="item-info">'+'<div class="item-name">'+highlighted+'</div>'+'<div class="item-cc">'+ccDisplay+'</div>'+'</div></div>';
    }

    autocompleteList.innerHTML=html;
    autocompleteList.classList.add('show');
    activeIndex=-1;
}

function seleccionarLider(nombre, cc) {
    nombreLiderInput.value=nombre;

    if (cc) {
        ccLiderInput.value=cc;
    }

    autocompleteList.classList.remove('show');
    activeIndex=-1;
    ccLiderInput.focus();
}

nombreLiderInput.addEventListener('input', function () {
        renderSugerencias(this.value);
    });

nombreLiderInput.addEventListener('focus', function () {
        if (this.value.trim().length >=2) {
            renderSugerencias(this.value);
        }
    });

autocompleteList.addEventListener('click', function (e) {
        var item=e.target.closest('.autocomplete-item');

        if (item) {
            seleccionarLider(item.dataset.nombre, item.dataset.cc);
        }
    });

nombreLiderInput.addEventListener('keydown', function (e) {
        var items=autocompleteList.querySelectorAll('.autocomplete-item');
        if ( !items.length || !autocompleteList.classList.contains('show')) return;

        if (e.key==='ArrowDown') {
            e.preventDefault();
            activeIndex=Math.min(activeIndex + 1, items.length - 1);
            updateActiveItem(items);
        }

        else if (e.key==='ArrowUp') {
            e.preventDefault();
            activeIndex=Math.max(activeIndex - 1, 0);
            updateActiveItem(items);
        }

        else if (e.key==='Enter' && activeIndex >=0) {
            e.preventDefault();
            var active=items[activeIndex];
            seleccionarLider(active.dataset.nombre, active.dataset.cc);
        }

        else if (e.key==='Escape') {
            autocompleteList.classList.remove('show');
            activeIndex=-1;
        }
    });

function updateActiveItem(items) {
    items.forEach(function (item, i) {
            item.classList.toggle('active', i===activeIndex);

            if (i===activeIndex) {
                item.scrollIntoView({
                    block: 'nearest'
                });
        }
    });
}

document.addEventListener('click', function (e) {
        if ( !e.target.closest('.autocomplete-wrapper')) {
            autocompleteList.classList.remove('show');
            activeIndex=-1;
        }
    });


function cargarMunicipios() {
    google.script.run .withSuccessHandler(function(municipios) {
            if (municipios && municipios.length > 0) {
                console.log('Municipios cargados: ' + municipios.length);
                // Actualizar lista de Cundinamarca con datos de la hoja
                colombiaData['Cundinamarca']=municipios;

                // Si Cundinamarca está seleccionado, refrescar el dropdown
                if (departamentoSelect.value==='Cundinamarca') {
                    poblarMunicipios('Cundinamarca');
                }
            }

        }) .withFailureHandler(function(error) {
            console.error('Error cargando municipios:', error);
        }) .getMunicipiosFromDatos();
}

